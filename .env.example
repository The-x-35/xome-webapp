# Xome web — environment configuration.
# Cloud LLM keys and Notion tokens are entered by users in the app (stored in
# their browser), so they are NOT configured here. These server-side values
# only activate the OAuth integrations, which need OAuth apps registered for
# your domain (e.g. https://app.xome.bot).
#
# Redirect URIs to register with each provider:
#   {origin}/api/oauth/callback/google
#   {origin}/api/oauth/callback/slack
#   {origin}/api/oauth/callback/github

# Google (Gmail + Calendar) — create a "Web application" OAuth client at
# console.cloud.google.com → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack — create an app at api.slack.com/apps, add the redirect URL, request the
# user scopes the app uses (chat:write, channels:read/history, search:read, …).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# GitHub — register an OAuth app at github.com/settings/developers.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
