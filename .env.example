# Xome web, environment configuration.
# Cloud LLM keys and Notion tokens are entered by users in the app (stored in
# their browser), so they are NOT configured here. These server-side values
# only activate the OAuth integrations, which need OAuth apps registered for
# your domain (e.g. https://app.xome.bot).
#
# Redirect URIs to register with each provider:
#   {origin}/api/oauth/callback/google
#   {origin}/api/oauth/callback/slack
#   {origin}/api/oauth/callback/github

# Google (Gmail + Calendar), create a "Web application" OAuth client at
# console.cloud.google.com → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack, create an app at api.slack.com/apps, add the redirect URL, request the
# user scopes the app uses (chat:write, channels:read/history, search:read, …).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# GitHub, register an OAuth app at github.com/settings/developers.
# GitHub OAuth apps allow one callback URL each, so use separate dev/prod apps:
# the base vars serve http://localhost, the *_PROD vars serve app.xome.bot.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_ID_PROD=
GITHUB_CLIENT_SECRET_PROD=

# The *_PROD convention works for any provider: when a request's origin host is
# the production host (default app.xome.bot, override with XOME_PROD_HOST), the
# *_CLIENT_ID_PROD / *_CLIENT_SECRET_PROD vars are used, falling back to the base
# vars when unset. Providers using one OAuth app with multiple redirect URIs
# (Google, Slack) need no *_PROD vars.
# XOME_PROD_HOST=app.xome.bot

# ── Solana (crypto wallet via Privy) ──────────────────────────────────────────
# Embedded Solana wallets + send/receive/swap. Create an app at dashboard.privy.io
# and enable Embedded wallets → Solana. The app id is public (client-side).
NEXT_PUBLIC_PRIVY_APP_ID=
# Solana JSON-RPC endpoint used server-side by /api/solana/rpc (kept off the
# client). Defaults to the public mainnet RPC; set a Helius/QuickNode URL for
# reliability.
SOLANA_RPC_URL=
# Jupiter API base for quotes/swaps/prices. Defaults to the keyless lite tier.
# NEXT_PUBLIC_JUPITER_BASE=https://lite-api.jup.ag

# ── MagicBlock private payments ───────────────────────────────────────────────
# Private SPL transfers inside a TEE-secured Ephemeral Rollup, plus the on-chain
# agent spend policy. Ships on devnet: the flow is new and the policy program is
# unaudited, so mainnet is opt-in. Leave unset for devnet.
# NEXT_PUBLIC_MAGICBLOCK_CLUSTER=devnet

# The xome_agent_policy program, which enforces the agent's spend caps on chain.
# Without it the private payment tools refuse to move anything.
# Devnet deployment:
NEXT_PUBLIC_XOME_POLICY_PROGRAM_ID=4DmoEYQEhm55f7VgaPdzLnToz2bRjByXYv319RFhVQJw

# Devnet RPC used by /api/solana/rpc?cluster=devnet. Defaults to the public
# endpoint, which rate limits aggressively; set a Helius/QuickNode devnet URL.
SOLANA_DEVNET_RPC_URL=
